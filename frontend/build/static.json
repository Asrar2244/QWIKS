{
  "root": "build/",
  "clean_urls": true,
  "routes": {
    "/menu/*": "/index.html",
    "/admin/*": "/index.html", 
    "/order-confirmation/*": "/index.html",
    "/test": "/index.html",
    "/*": "/index.html"
  },
  "headers": {
    "/**": {
      "Cache-Control": "no-cache, no-store, must-revalidate"
    },
    "/static/**": {
      "Cache-Control": "public, max-age=31536000"
    }
  }
}
